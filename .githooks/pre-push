#!/usr/bin/env bash
set -e
# skip in CI / when uv and python3 missing — semantic-release push must not fail on hook
if [ "${HUSKY:-}" = "0" ]; then exit 0; fi
if ! command -v uv >/dev/null 2>&1 && ! command -v python3 >/dev/null 2>&1; then exit 0; fi
# disable auto-fix with PREPUSH_AUTOFIX=0
if [ "${PREPUSH_AUTOFIX:-1}" = "0" ]; then
  _AUTOFIX=0
else
  _AUTOFIX=1
fi
# pre-push hook: ensure CHANGELOG.md Unreleased is up-to-date — auto-fixes with amend when stale
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  range="$remote_sha..$local_sha"
  [ "$remote_sha" = "0000000000000000000000000000000000000000" ] && range="$local_sha"
  if ! git log "$range" --pretty=%s --no-merges | grep -Eq '^(feat|fix|perf|revert|docs)(\(.+\))?!?: '; then
    if ! git log "$range" --pretty=%B --no-merges | grep -q "BREAKING CHANGE:"; then
      continue
    fi
  fi
  tmp=$(mktemp)
  cp CHANGELOG.md "$tmp" 2>/dev/null || touch "$tmp"
  if command -v uv >/dev/null 2>&1; then
    uv run python scripts/changelog-unreleased.py update >/dev/null 2>&1 || python3 scripts/changelog-unreleased.py update >/dev/null 2>&1 || true
  else
    python3 scripts/changelog-unreleased.py update >/dev/null 2>&1 || true
  fi
  if ! diff -q CHANGELOG.md "$tmp" >/dev/null; then
    if [ "$_AUTOFIX" = "1" ]; then
      echo "[pre-push] CHANGELOG.md [Unreleased] stale — auto-fixing..." >&2
      git add CHANGELOG.md
      if git rev-parse --verify HEAD >/dev/null 2>&1; then
        if git commit --amend --no-edit --no-verify >/dev/null 2>&1; then
          rm -f "$tmp"
          cat >&2 <<EOF

> [!warning] pre-push hook auto-fixed CHANGELOG.md and amended HEAD
A visible conventional commit is in the push range but ## [Unreleased] was stale.
The hook ran \`scripts/changelog-unreleased.py update\` and amended the current commit:
  git commit --amend --no-edit --no-verify   # HEAD is now $(git rev-parse --short HEAD)
The current push was BLOCKED so the amended commit is not pushed yet.
Re-run your push to send the amended commit:
  git push
(If you had extra git commands queued, skip them — the hook already amended HEAD.)
EOF
          exit 1
        fi
      fi
      echo "[pre-push] auto-fix failed — restoring original and blocking push" >&2
    fi
    cat >&2 <<'EOF'
> [!warning] CHANGELOG.md [Unreleased] stale
Visible conventional commit in push range but Unreleased not updated.
Fix:
  # Do NOT hand-edit CHANGELOG.md — just re-run the commit command directly.
  # The hook auto-fixes (amends HEAD) on the next attempt and blocks with a warning.
  git commit --amend --no-edit --no-verify && git push --force-with-lease
  # or, if the change is not yet committed, simply re-run your original commit
  # command (e.g. git commit -m 'feat: ...') — the hook updates Unreleased for you.
Bypass (human): git push --no-verify  or  PREPUSH_AUTOFIX=0 git push
EOF
    cp "$tmp" CHANGELOG.md
    rm -f "$tmp"
    exit 1
  fi
  rm -f "$tmp"
done

# Ledger floor (#48a) — the same deterministic gate changelog-check.yml runs, available
# before a push instead of only on the PR.
#
# With a PR number the check is exact. Before the PR exists the attribution rule cannot pass
# yet (entries must name the PR that will carry them), so that case warns instead of
# deadlocking the first push of a branch; CI still enforces it on the pull request.
if command -v python3 >/dev/null 2>&1 && [ -f scripts/changelog-gate.py ]; then
  _pr=""
  if command -v gh >/dev/null 2>&1; then
    _pr=$(gh pr view --json number -q .number 2>/dev/null || true)
  fi
  if [ -n "$_pr" ]; then
    if ! python3 scripts/changelog-gate.py ledger --pr "$_pr" >/dev/null 2>&1; then
      echo "[pre-push] changelog ledger floor failed for PR #$_pr — blocking push" >&2
      python3 scripts/changelog-gate.py ledger --pr "$_pr" >&2 || true
      echo "Fix the [Unreleased] attribution above, then re-run the push." >&2
      exit 1
    fi
  elif ! python3 scripts/changelog-gate.py ledger >/dev/null 2>&1; then
    echo "[pre-push] note: changelog ledger floor is not satisfiable yet (no PR to check against)." >&2
    echo "  It must pass before review: python3 scripts/changelog-gate.py ledger --pr <N>" >&2
  fi
fi
