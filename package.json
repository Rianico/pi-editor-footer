{
  "name": "pi-editor-footer",
  "type": "module",
  "description": "Pi TUI theme — project-aware footer, model border, and skill detail window (TrackingEditor, live theme)",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "prepare": "husky || true",
    "lint": "oxlint src test",
    "format": "oxfmt --check src test --ignore-path .gitignore",
    "format:fix": "oxfmt src test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^24.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "oxlint": "^1.13.0",
    "oxfmt": "^0.15.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "version": "0.13.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "pi-theme",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24"
  }
}
