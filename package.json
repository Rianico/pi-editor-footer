{
  "name": "pi-editor-footer",
  "type": "module",
  "description": "Pi TUI theme — project-aware footer, model border, and skill detail window (TrackingEditor, live theme)",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "prepare": "tsc --project tsconfig.build.json || echo 'skip build: tsc not available'"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "version": "0.6.1",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "pi-theme",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
